# Copy to `.env` and fill in real values. Never commit `.env`.

# ── Database (Prisma / MySQL 8) ─────────────────────────────────────────
DATABASE_URL="mysql://user:password@localhost:3306/rayanhesab"

# ── Public site ─────────────────────────────────────────────────────────
# Canonical public URL (sitemap, metadata, payment callback in production).
NEXT_PUBLIC_SITE_URL="https://rayan-accounting.ir"
# Optional override for the payment callback base URL.
# APP_URL="https://rayan-accounting.ir"
# Timezone used for admin date/time fields (default Asia/Tehran).
# NEXT_PUBLIC_APP_TIMEZONE="Asia/Tehran"

# ── Admin panel session ─────────────────────────────────────────────────
# Required in production, at least 32 random characters:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=""
ADMIN_SESSION_COOKIE="rayan_admin_session"
ADMIN_SESSION_MAX_AGE=86400

# ── Payment gateway (Zarinpal) ──────────────────────────────────────────
ZARINPAL_MERCHANT_ID=""
# "true" to use sandbox.zarinpal.com while testing.
ZARINPAL_SANDBOX="false"
# Development only: simulate successful payments without a gateway.
# Ignored when NODE_ENV=production.
# PAYMENT_DEV_FAKE="true"

# ── File storage ────────────────────────────────────────────────────────
# Uploaded images (public) and resumes (private). Use a persistent volume.
# STORAGE_DIR="/var/lib/rayanhesab/storage"

# Optional: Google Search Console verification token.
# GOOGLE_SITE_VERIFICATION=""
